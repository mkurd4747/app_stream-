TELEMETRY_STREAM_APP_NAME=Persistent Telemetry Stream API
TELEMETRY_STREAM_APP_VERSION=2.0.0
TELEMETRY_STREAM_ENVIRONMENT=development
TELEMETRY_STREAM_DATABASE_URL=sqlite:///telemetry.db
TELEMETRY_STREAM_OAUTH_CLIENT_ID=telemetry-client
TELEMETRY_STREAM_OAUTH_CLIENT_SECRET=replace-with-a-secure-secret
TELEMETRY_STREAM_OAUTH_SIGNING_KEY=replace-with-a-secure-signing-key
TELEMETRY_STREAM_OAUTH_TOKEN_EXPIRE_MINUTES=30